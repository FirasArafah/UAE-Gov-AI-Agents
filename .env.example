# === App ===
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
UI_PORT=5173

# === PostgreSQL ===
POSTGRES_USER=synora
POSTGRES_PASSWORD=synora_dev_password
POSTGRES_DB=synora
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://synora:synora_dev_password@postgres:5432/synora

# === Ollama (local AI — no external APIs) ===
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434

# === Models (LOCKED) ===
# LLM: reasoning + role-play + multi-agent coordination
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
# Embeddings: multilingual (AR/EN) + 1024 dim
OLLAMA_EMBED_MODEL=bge-m3

# === Embeddings ===
EMBEDDING_DIM=1024

# === RAG ===
RAG_TOP_K=6
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100